# Базовый URL API. Пусто = тот же origin, что и веб-апп (продакшен-режим,
# когда статика раздаётся ботом). Для отдельного хостинга фронтенда укажите
# полный URL, например https://synapseairwa.com
VITE_API_BASE=""

# Прокси для локальной разработки (vite dev server → bot.py)
VITE_API_PROXY="http://localhost:8080"
